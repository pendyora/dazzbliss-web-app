# ---- Dazzbliss storefront: environment template (copy to .env.local) ----
# Every third-party key is empty on purpose: nothing loads or reports anywhere until Dazzbliss's own
# account is set. See dazzbliss-backend-portal/docs/THIRD_PARTY_SERVICES.md and docs/OPEN_ITEMS.md.

NEXT_PUBLIC_NODE_ENV="local"
# Nest backend API (trailing slash) and this site's own URL
NEXT_PUBLIC_API_URL="http://localhost:6300/api/v1/"
NEXT_PUBLIC_BASE_URL="http://localhost:7001"

# Request/response encryption: must match the backend's CHIPER / TERIFF / PLAN
NEXT_PUBLIC_CHIPER="<same as backend CHIPER>"
NEXT_PUBLIC_TERIFF="<same as backend TERIFF>"
NEXT_PUBLIC_PLAN="<same as backend PLAN>"

# Search engines: keep false until the site is live (robots.txt + noindex on every page)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Analytics / ads (each loads only with its own ID and the visitor's consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CART=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CHECKOUT=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PURCHASE=

# Email marketing (Klaviyo onsite)
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
NEXT_PUBLIC_KLAVIYO_DEBUG=false

# Reviews (Yotpo)
NEXT_PUBLIC_YOTPO_APP_KEY=
NEXT_PUBLIC_YOTPO_API_URL=
NEXT_PUBLIC_YOTPO_APP_INSTANCE_ID=
NEXT_PUBLIC_YOTPO_APP_INSTANCE_STAR_ID=
NEXT_PUBLIC_YOTPO_CAROUSEL_INSTANCE_ID=
NEXT_PUBLIC_YOTPO_SEO_PAGE_INSTANCE_ID=

# Payments
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_AFFIRM_PUBLIC_KEY=
NEXT_PUBLIC_AFFIRM_JS_URL=
NEXT_PUBLIC_GOOGLE_PAY_ENVIRONMENT=TEST
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_NAME=
NEXT_PUBLIC_GOOGLE_PAY_GATEWAY_MERCHANT_ID=
NEXT_PUBLIC_GOOGLE_PAY_JS_URL=
# Shop Pay (Shopify): off; when off, the Shopify SDK is not loaded
NEXT_PUBLIC_SHOP_PAY_ENABLED=false

# Bot protection (Cloudflare Turnstile)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Social / Instagram feed (hidden while empty)
NEXT_PUBLIC_INSTAGRAM_PROFILE_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_INSTAGRAM_MAX_POSTS=
NEXT_PUBLIC_INSTAGRAM_REVALIDATE_SECONDS=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_PINTEREST_URL=

# Image CDN hosts allowed by next/image, and CMS link hosts treated as this site (comma-separated)
NEXT_IMAGE_HOSTS=
NEXT_PUBLIC_CMS_LINK_HOSTS=

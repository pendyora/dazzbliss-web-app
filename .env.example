# API Configuration
NEXT_PUBLIC_API_URL=

CYPHER_KEY=

# Encryption Configurations
NEXT_PUBLIC_CHIPER=
NEXT_PUBLIC_TERIFF=
NEXT_PUBLIC_PLAN=
# Remote image hosts for next/image, comma-separated (e.g. the image CDN host)
NEXT_IMAGE_HOSTS=

# Absolute-link hosts in CMS menu data to treat as this site, comma-separated (e.g. a previous domain)
NEXT_PUBLIC_CMS_LINK_HOSTS=

# Social profiles (a link without a URL is hidden)
NEXT_PUBLIC_INSTAGRAM_PROFILE_URL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_PINTEREST_URL=

# Search engines: keep false until the site is live (robots.txt + noindex on every page).
NEXT_PUBLIC_ALLOW_INDEXING=false

# Shop Pay (Shopify): off until the Dazzbliss Shopify account is set up; when off, the Shopify SDK is not loaded.
NEXT_PUBLIC_SHOP_PAY_ENABLED=false
